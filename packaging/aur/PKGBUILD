# AUR pmog-bin: o binário estático da release (scripts/package.sh aur troca @VERSION@).
pkgname=pmog-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Jogo de terminal multiplayer na rede local"
arch=('x86_64')
url="https://github.com/Parsec-Inc/pmog"
license=('LicenseRef-Proprietary')
provides=('pmog')
conflicts=('pmog')
source=("pmog-$pkgver::$url/releases/download/$pkgver/pmog-linux"
        "pmog-$pkgver.sig::$url/releases/download/$pkgver/pmog-linux.sig"
        "pmog.xml::$url/raw/$pkgver/packaging/linux/pmog.xml"
        "ufw-pmog::$url/raw/$pkgver/packaging/linux/ufw-pmog")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "pmog-$pkgver" "$pkgdir/usr/bin/pmog"
    install -Dm644 "pmog-$pkgver.sig" "$pkgdir/usr/bin/pmog.sig"
    install -Dm644 pmog.xml "$pkgdir/usr/lib/firewalld/services/pmog.xml"
    install -Dm644 ufw-pmog "$pkgdir/etc/ufw/applications.d/pmog"
}
